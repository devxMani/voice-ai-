# LiveKit project credentials (required by LiveKit Inference).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Immutable source/build ID for baseline runs. Set to the commit SHA or image digest
# deployed to this bridge. Change it whenever the baseline agent build/config changes.
VOICE_AGENT_VERSION=replace-with-immutable-commit-sha-or-image-digest
VOICE_AGENT_LLM_MODEL=google/gemma-4-31b-it

# Local Pixi bridge. Keep host bound to loopback and use a randomly generated token
# with at least 32 characters. Use the same token as PIXI_AGENT_API_KEY in Pixi.
VOICE_BRIDGE_HOST=127.0.0.1
VOICE_BRIDGE_PORT=8787
VOICE_BRIDGE_TOKEN=replace-with-a-random-secret-at-least-32-characters
VOICE_BRIDGE_TIMEOUT_SECONDS=25
